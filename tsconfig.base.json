{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@spotpatch/astro": ["packages/astro/src/index.ts"],
      "@spotpatch/agent": ["packages/agent/src/index.ts"],
      "@spotpatch/analyzer": ["packages/analyzer/src/index.ts"],
      "@spotpatch/bridge": ["packages/bridge/src/index.ts"],
      "@spotpatch/compiler": ["packages/compiler/src/index.ts"],
      "@spotpatch/dev-server": ["packages/dev-server/src/index.ts"],
      "@spotpatch/next": ["packages/next/src/index.ts"],
      "@spotpatch/shared": ["packages/shared/src/index.ts"],
      "@spotpatch/shared/data-flow-runtime": [
        "packages/shared/src/data-flow-runtime.ts"
      ],
      "@spotpatch/shared/external-agent-node": [
        "packages/shared/src/external-agent-node.ts"
      ],
      "@spotpatch/shared/external-handoff-browser": [
        "packages/shared/src/external-handoff-browser.ts"
      ],
      "@spotpatch/shared/contextual-ask-browser": [
        "packages/shared/src/contextual-ask-browser.ts"
      ],
      "@spotpatch/shared/contextual-ask-node": [
        "packages/shared/src/contextual-ask-node.ts"
      ],
      "@spotpatch/react-adapter": ["packages/react-adapter/src/index.ts"],
      "@spotpatch/runtime": ["packages/runtime/src/index.ts"],
      "@spotpatch/runtime/contextual-ask-panel": [
        "packages/runtime/src/contextual-ask-panel-entry.ts"
      ],
      "@spotpatch/runtime/data-flow": ["packages/runtime/src/data-flow-entry.ts"],
      "@spotpatch/runtime/data-flow-panel": [
        "packages/runtime/src/data-flow-panel-entry.ts"
      ],
      "@spotpatch/runtime/external-handoff-panel": [
        "packages/runtime/src/external-handoff-panel-entry.ts"
      ],
      "@spotpatch/runtime/motion": ["packages/runtime/src/motion-entry.ts"],
      "@spotpatch/vite": ["packages/vite/src/index.ts"]
    }
  }
}
