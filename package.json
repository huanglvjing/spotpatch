{
  "name": "spotpatch-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first React page feedback with source-aware AI context.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "changeset": "changeset",
    "clean": "pnpm --filter './packages/*' clean",
    "dev": "pnpm --filter @spotpatch/playground dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages playgrounds tests *.ts --max-warnings 0",
    "package:validate": "pnpm build && pnpm --filter './packages/*' exec publint && pnpm --filter './packages/*' exec attw --pack .",
    "release": "pnpm build && changeset publish",
    "test": "pnpm test:unit",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:production-leakage": "vitest run tests/production",
    "test:unit": "vitest run packages tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.33",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
