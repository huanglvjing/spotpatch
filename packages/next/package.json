{
  "name": "@spotpatch/next",
  "version": "0.7.0",
  "description": "Development-only Next.js adapter and CLI for SpotPatch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanglvjing/spotpatch.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/huanglvjing/spotpatch#readme",
  "bugs": {
    "url": "https://github.com/huanglvjing/spotpatch/issues"
  },
  "keywords": [
    "spotpatch",
    "nextjs",
    "react",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/client.cjs",
    "./dist/client.js",
    "./dist/data-flow-runtime.cjs",
    "./dist/data-flow-runtime.js"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "loader.cjs",
    "loader.d.cts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "spotpatch-next": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./loader": {
      "types": "./loader.d.cts",
      "default": "./loader.cjs"
    },
    "./data-flow-runtime": {
      "import": {
        "types": "./dist/data-flow-runtime.d.ts",
        "default": "./dist/data-flow-runtime.js"
      },
      "require": {
        "types": "./dist/data-flow-runtime.d.cts",
        "default": "./dist/data-flow-runtime.cjs"
      }
    },
    "./noop": {
      "import": {
        "types": "./dist/noop.d.ts",
        "default": "./dist/noop.js"
      },
      "require": {
        "types": "./dist/noop.d.cts",
        "default": "./dist/noop.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/client.d.ts"
      ],
      "data-flow-runtime": [
        "dist/data-flow-runtime.d.ts"
      ],
      "loader": [
        "loader.d.cts"
      ],
      "noop": [
        "dist/noop.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean && tsup --config tsup.cli.config.ts && tsup --config tsup.loader.config.ts && tsup --config tsup.client.config.ts && pnpm verify:loader",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:loader": "node scripts/verify-loader.cjs"
  },
  "dependencies": {
    "@spotpatch/bridge": "workspace:^",
    "@spotpatch/compiler": "workspace:^",
    "@spotpatch/dev-server": "workspace:^",
    "@spotpatch/runtime": "workspace:^",
    "@spotpatch/shared": "workspace:^",
    "bippy": "0.6.1",
    "magic-string": "1.1.0",
    "oxc-parser": "0.143.0"
  },
  "peerDependencies": {
    "next": ">=15.3.0 <17.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
