{
  "name": "@spotpatch/agent",
  "version": "1.2.4",
  "description": "Node-only provider, tool, worktree, and validation engine for SpotPatch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanglvjing/spotpatch.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/huanglvjing/spotpatch#readme",
  "bugs": {
    "url": "https://github.com/huanglvjing/spotpatch/issues"
  },
  "keywords": [
    "spotpatch",
    "ai-agent",
    "code-editing",
    "git-worktree"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@spotpatch/shared": "workspace:^",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
