---
const props = { class: 'card', 'data-spotpatch-source': 'invalid-spread-marker' };
---
<section {...props}>
  <h2>模型卡片 😀</h2>
  <slot><span>默认内容</span></slot>
  <button id="counter" type="button">Count 0</button>
</section>
<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('#counter');
    let count = 0;
    button?.addEventListener('click', () => { button.textContent = `Count ${++count}`; });
  });
</script>
<style>
  .card { border: 2px solid teal; padding: 1rem; }
</style>
