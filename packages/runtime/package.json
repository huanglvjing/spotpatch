{
  "name": "@spotpatch/runtime",
  "version": "1.13.0",
  "description": "Browser runtime, collectors, and Shadow DOM UI for SpotPatch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanglvjing/spotpatch.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/huanglvjing/spotpatch#readme",
  "bugs": {
    "url": "https://github.com/huanglvjing/spotpatch/issues"
  },
  "keywords": [
    "spotpatch",
    "react",
    "dom-inspector",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data-flow": {
      "import": {
        "types": "./dist/data-flow.d.ts",
        "default": "./dist/data-flow.js"
      },
      "require": {
        "types": "./dist/data-flow.d.cts",
        "default": "./dist/data-flow.cjs"
      }
    },
    "./data-flow-panel": {
      "import": {
        "types": "./dist/data-flow-panel.d.ts",
        "default": "./dist/data-flow-panel.js"
      },
      "require": {
        "types": "./dist/data-flow-panel.d.cts",
        "default": "./dist/data-flow-panel.cjs"
      }
    },
    "./external-handoff-panel": {
      "import": {
        "types": "./dist/external-handoff-panel.d.ts",
        "default": "./dist/external-handoff-panel.js"
      },
      "require": {
        "types": "./dist/external-handoff-panel.d.cts",
        "default": "./dist/external-handoff-panel.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion.d.ts",
        "default": "./dist/motion.js"
      },
      "require": {
        "types": "./dist/motion.d.cts",
        "default": "./dist/motion.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "data-flow": [
        "dist/data-flow.d.ts"
      ],
      "data-flow-panel": [
        "dist/data-flow-panel.d.ts"
      ],
      "external-handoff-panel": [
        "dist/external-handoff-panel.d.ts"
      ],
      "motion": [
        "dist/motion.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm clean && tsup --config tsup.config.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@spotpatch/react-adapter": "workspace:^",
    "@spotpatch/shared": "workspace:^",
    "gsap": "3.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
