{
  "name": "spotpatch-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first React page feedback with source-aware AI context.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanglvjing/spotpatch.git"
  },
  "homepage": "https://github.com/huanglvjing/spotpatch#readme",
  "bugs": {
    "url": "https://github.com/huanglvjing/spotpatch/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "changeset": "changeset",
    "clean": "pnpm --filter './packages/*' clean",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages playgrounds experiments/next-adapter scripts tests *.ts --max-warnings 0",
    "package:validate": "pnpm build && pnpm --filter './packages/*' exec publint && pnpm --filter './packages/*' exec attw --pack .",
    "release": "pnpm build && changeset publish",
    "test": "pnpm test:unit",
    "test:compatibility": "pnpm --filter './playgrounds/compat-vite*' build && pnpm --filter './playgrounds/compat-vite*' verify",
    "test:astro:compatibility": "pnpm --filter './playgrounds/compat-astro*' build && pnpm --filter './playgrounds/compat-astro*' verify",
    "test:contextual-ask-q1": "pnpm --filter @spotpatch/contextual-ask-q1-experiments test",
    "test:contextual-ask-q1:browser": "pnpm --filter @spotpatch/contextual-ask-q1-experiments test:browser",
    "test:contextual-ask-q1:live": "pnpm --filter @spotpatch/contextual-ask-q1-experiments test:codex-live",
    "test:contextual-ask-q6:live": "SPOTPATCH_RUN_CODEX_Q6_LIVE=1 vitest run packages/bridge/src/active/codex/ask-adapter.live.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:astro": "playwright test --config playwright.astro.config.ts",
    "test:next-poc": "pnpm --filter @spotpatch/next-adapter-experiments test:loader",
    "test:next-real-host": "pnpm --filter @spotpatch/next-adapter-experiments test:real-host",
    "test:next-runtime-real-host": "pnpm --filter @spotpatch/next-adapter-experiments test:runtime-real-host",
    "test:performance": "vitest run tests/performance",
    "test:package-beta": "node scripts/verify-contextual-ask-beta-package.mjs",
    "test:production-leakage": "pnpm build && vitest run tests/production",
    "test:unit": "vitest run packages scripts tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.33",
    "@types/react": "18.3.28",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "react": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
