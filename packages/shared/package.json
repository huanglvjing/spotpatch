{
  "name": "@spotpatch/shared",
  "version": "1.12.0",
  "description": "Shared immutable models and protocol definitions for SpotPatch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanglvjing/spotpatch.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/huanglvjing/spotpatch#readme",
  "bugs": {
    "url": "https://github.com/huanglvjing/spotpatch/issues"
  },
  "keywords": [
    "spotpatch",
    "developer-tools",
    "protocol",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data-flow-runtime": {
      "import": {
        "types": "./dist/data-flow-runtime.d.ts",
        "default": "./dist/data-flow-runtime.js"
      },
      "require": {
        "types": "./dist/data-flow-runtime.d.cts",
        "default": "./dist/data-flow-runtime.cjs"
      }
    },
    "./external-agent-node": {
      "import": {
        "types": "./dist/external-agent-node.d.ts",
        "default": "./dist/external-agent-node.js"
      },
      "require": {
        "types": "./dist/external-agent-node.d.cts",
        "default": "./dist/external-agent-node.cjs"
      }
    },
    "./external-handoff-browser": {
      "import": {
        "types": "./dist/external-handoff-browser.d.ts",
        "default": "./dist/external-handoff-browser.js"
      },
      "require": {
        "types": "./dist/external-handoff-browser.d.cts",
        "default": "./dist/external-handoff-browser.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "data-flow-runtime": [
        "dist/data-flow-runtime.d.ts"
      ],
      "external-agent-node": [
        "dist/external-agent-node.d.ts"
      ],
      "external-handoff-browser": [
        "dist/external-handoff-browser.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/data-flow-runtime.ts src/external-agent-node.ts src/external-handoff-browser.ts --format esm,cjs --dts --sourcemap --clean",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
